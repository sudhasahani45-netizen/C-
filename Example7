#include <stdio.h>

int main()
{
    char name[30], cls[20];
    int roll;

    printf("Enter your name: ");
    scanf("%s", name);

    printf("Enter your class: ");
    scanf("%s", cls);

    printf("Enter your roll number: ");
    scanf("%d", &roll);

    printf("\nName: %s", name);
    printf("\nClass: %s", cls);
    printf("\nRoll Number: %d", roll);

    return 0;
}
